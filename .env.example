# --- Redis (broker, Pub/Sub, state, rate limit, tokens) -----------------
RUBETHYST_REDIS_URL=redis://localhost:6379/0
# Optional explicit Celery broker / backend (default to RUBETHYST_REDIS_URL).
# RUBETHYST_CELERY_BROKER_URL=redis://redis:6379/0
# RUBETHYST_CELERY_RESULT_BACKEND=redis://redis:6379/1
RUBETHYST_CELERY_DEFAULT_QUEUE=snap.default
RUBETHYST_CELERY_PRO_QUEUE=snap.pro

# --- Storage & download delivery ----------------------------------------
RUBETHYST_DOWNLOADS_DIR=./.snap-data/downloads
RUBETHYST_PUBLIC_BASE_URL=http://localhost:8000
# Sign download tokens. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
RUBETHYST_DOWNLOAD_TOKEN_SECRET=replace-with-a-long-random-string
RUBETHYST_DOWNLOAD_TOKEN_TTL_SECONDS=3600

# --- Retention --------------------------------------------------------
RUBETHYST_ARTIFACT_TTL_HOURS_FREE=6
RUBETHYST_ARTIFACT_TTL_HOURS_PRO=48

# --- Cleanup (Celery Beat) -------------------------------------------
RUBETHYST_CLEANUP_INTERVAL_SECONDS=900
RUBETHYST_CEMETERY_INTERVAL_SECONDS=3600
RUBETHYST_CEMETERY_ORPHAN_AGE_HOURS=24

# --- Plan limits ------------------------------------------------------
RUBETHYST_FREE_MAX_DURATION_SECONDS=900
RUBETHYST_FREE_MAX_FILESIZE_MB=1024
RUBETHYST_FREE_MAX_HEIGHT=720
RUBETHYST_FREE_CONCURRENCY=1
RUBETHYST_FREE_RATE_PER_HOUR=10

RUBETHYST_PRO_MAX_DURATION_SECONDS=43200
RUBETHYST_PRO_MAX_FILESIZE_MB=8192
RUBETHYST_PRO_MAX_HEIGHT=2160
RUBETHYST_PRO_CONCURRENCY=3
RUBETHYST_PRO_RATE_PER_HOUR=120

# --- HTTP -------------------------------------------------------------
RUBETHYST_API_HOST=0.0.0.0
RUBETHYST_API_PORT=8000
# JSON array; dev inclui o Next em :3000, prod aponta para o host público do app.
RUBETHYST_CORS_ORIGINS=["http://localhost:3000","https://app.rubethystlab.com"]

# --- Frontend (Next.js) -----------------------------------------------
# Definir só em frontend/.env.local ou no build Docker — não uses NEXT_PUBLIC_*
# na raiz: o Next não lê o .env do backend. Em dev local o front usa o mesmo
# host que o browser na porta 8000 (ver frontend/lib/api.ts).
